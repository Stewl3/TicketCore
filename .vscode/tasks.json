{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Ticket Creator",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/g++.exe",
      "args": [
        "-Wall",
        "-Wextra",
        "-g3",
        "main.cpp",
        "MainMenu.cpp",
        "TicketCreator.cpp",
        "TicketViewer.cpp",
        "Helpers.cpp",
        "ExtraPartsTracker.cpp",
        "-o",
        "output/main.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Build Ticket Creator (WSL)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-g",
        "main.cpp",
        "MainMenu.cpp",
        "TicketCreator.cpp",
        "TicketViewer.cpp",
        "Helpers.cpp",
        "ExtraPartsTracker.cpp",
        "-o",
        "output/main-linux"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
